   {\n      \"seq\": 79,\n      \"module\": \"推广人员版小程序\",\n      \"sub_module\": \"我的\",\n      \"function\": \"保证金账户（余额/扣罚/退还）\",\n      \"sub_function\": \"扣罚记录列表\",\n      \"description\": \"按时间倒序展示所有保证金扣罚记录，每条记录包含扣罚金额、扣罚原因（如跑单、质检严重不符）、对应订单编号（若有）、扣罚时间，列表为空时显示'暂无扣罚记录'\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 80,\n      \"module\": \"推广人员版小程序\",\n      \"sub_module\": \"我的\",\n      \"function\": \"保证金账户（余额/扣罚/退还）\",\n      \"sub_function\": \"退还申请流程\",\n      \"description\": \"点击'申请退还'后进入申请页面，要求确认退还原因（如不再合作），提交后显示'退还申请已提交，等待审核'，后台运营审核后执行退还操作，申请记录可在历史中查看状态（待审核/已退还/已拒绝）\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 81,\n      \"module\": \"推广人员版小程序\",\n      \"sub_module\": \"我的\",\n      \"function\": \"个人资料上传审核\",\n      \"sub_function\": \"资料上传表单\",\n      \"description\": \"个人资料页面，包含身份证正面照片上传、身份证反面照片上传、本人持身份证照片上传三个上传入口，每个入口支持从相册选择或拍照，上传后显示缩略图预览，支持删除重新上传，页面底部有'提交审核'按钮\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 82,\n      \"module\": \"推广人员版小程序\",\n      \"sub_module\": \"我的\",\n      \"function\": \"个人资料上传审核\",\n      \"sub_function\": \"审核状态展示\",\n      \"description\": \"提交审核后，页面顶部显示审核状态标签：'审核中'（黄色）、'审核通过'（绿色）、'审核驳回'（红色，并显示驳回原因），审核通过后资料锁定不可修改，审核驳回可重新上传后再次提交\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 83,\n      \"module\": \"推广人员版小程序\",\n      \"sub_module\": \"我的\",\n      \"function\": \"线下培训状态\",\n      \"sub_function\": \"线下培训状态展示\",\n      \"description\": \"我的页面内展示线下培训状态区域，以标签形式显示当前培训状态：'未参加'（灰色，提示需参加公司组织的线下培训）、'已参加待审核'（黄色）、'已通过'（绿色）、'未通过'（红色），状态为'未参加'或'未通过'时显示'去参加'按钮引导联系客服或查看培训安排\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 84,\n      \"module\": \"推广人员版小程序\",\n      \"sub_module\": \"AI智能体估价入口\",\n      \"function\": \"AI对话估价\",\n      \"sub_function\": \"帮用户估价入口（底部导航）\",\n      \"description\": \"推广人员版小程序底部导航栏新增「AI估价」Tab，作为AI智能体对话的固定入口，点击后直接进入对话界面，推广人员可通过此入口为已扫码绑定的客户发起估价，无需客户自行操作，符合推广人员帮用户估价的场景。\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 85,\n      \"module\": \"推广人员版小程序\",\n      \"sub_module\": \"AI智能体估价入口\",\n      \"function\": \"AI对话估价\",\n      \"sub_function\": \"AI对话估价·输入型号/拍照\",\n      \"description\": \"进入AI对话后，推广人员可代替用户以文字输入手机品牌型号，或直接拍摄手机照片上传，AI自动识别型号及机况（如外观、屏幕、开机状态），支持多轮追问补充内存、成色等细节，整个过程在推广人员端完成，实现帮用户估价的交互。\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 86,\n      \"module\": \"推广人员版小程序\",\n      \"sub_module\": \"AI智能体估价入口\",\n      \"function\": \"AI对话估价\",\n      \"sub_function\": \"AI返回预估回收价\",\n      \"description\": \"AI根据收集的型号、机况信息，调用库存系统基准价并应用品类下调比例（废旧手机30%、二手手机15%等），实时计算并展示预估回收价，同时附加统一结尾话术「此为AI预估价格，仅供参考，最终实际价格需当面验机确认」，推广人员可据此与用户沟通预期价格。\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 87,\n      \"module\": \"推广人员版小程序\",\n      \"sub_module\": \"AI智能体估价入口\",\n      \"function\": \"AI对话估价\",\n      \"sub_function\": \"确认成交按钮（验机后触发）\",\n      \"description\": \"在AI返回估价结果后，对话界面或结果页显示「确认成交」按钮，推广人员线下对照验机清单（品牌型号、开机情况、屏幕状况、是否进系统等）逐项确认无误后，点击该按钮触发公司向用户微信零钱打款，差价佣金进入推广人员冻结余额，同时自动生成待发货订单进入发货管理流程。\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 88,\n      \"module\": \"Web运营后台\",\n      \"sub_module\": \"控制台\",\n      \"function\": \"今日数据概览\",\n      \"sub_function\": \"新增订单数卡片\",\n      \"description\": \"控制台顶部核心指标卡片之一，显示当日新增订单总数（即新增用户留资/估价请求数），数字以加粗字体突出显示，指标名称位于数字下方，未加载时显示骨架屏占位\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 89,\n      \"module\": \"Web运营后台\",\n      \"sub_module\": \"控制台\",\n      \"function\": \"今日数据概览\",\n      \"sub_function\": \"成交单数卡片\",\n      \"description\": \"并列展示的指标卡片，显示当日已成交订单数（状态为'已成交'的订单），数字格式为整数，当为0时显示'—'，支持点击后跳转至订单管理并自动筛选当日已成交订单\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 90,\n      \"module\": \"Web运营后台\",\n      \"sub_module\": \"控制台\",\n      \"function\": \"今日数据概览\",\n      \"sub_function\": \"发货单数卡片\",\n      \"description\": \"展示当日已发货订单数，包含通过京东物流和自行发货两种方式的订单，发货后估价金额进入冻结余额，同时待质检单数在另一张卡片中单独展示\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 91,\n      \"module\": \"Web运营后台\",\n      \"sub_module\": \"控制台\",\n      \"function\": \"今日数据概览\",\n      \"sub_function\": \"待质检单数卡片\",\n      \"description\": \"展示当日处于待质检状态的订单数，点击后跳转至订单管理并自动筛选待质检订单，数字高亮为橙色以提示需要尽快处理\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 92,\n      \"module\": \"Web运营后台\",\n      \"sub_module\": \"控制台\",\n      \"function\": \"用户增长量统计\",\n      \"sub_function\": \"今日新增C端用户数\",\n      \"description\": \"显示当天通过C端小程序授权登录的新增用户数量，数据每5分钟刷新，与累计用户数并排展示，新用户定义为首日完成微信授权登录\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 93,\n      \"module\": \"Web运营后台\",\n      \"sub_module\": \"控制台\",\n      \"function\": \"用户增长量统计\",\n      \"sub_function\": \"累计用户数\",\n      \"description\": \"显示从平台上线至今日的所有C端用户去重总数，数据实时累加，支持悬停显示精确数字，点击可查看趋势（如需）\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 94,\n      \"module\": \"Web运营后台\",\n      \"sub_module\": \"控制台\",\n      \"function\": \"门店数量统计\",\n      \"sub_function\": \"合作门店总数\",\n      \"description\": \"显示已签署合作协议且账号已开通的门店总数，数字格式如'128家'，提供环比上月增长率（绿色向上箭头或红色向下箭头）\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 95,\n      \"module\": \"Web运营后台\",\n      \"sub_module\": \"控制台\",\n      \"function\": \"门店数量统计\",\n      \"sub_function\": \"本月新增门店数\",\n      \"description\": \"显示自然月内新入驻并开通账号的门店数量，按门店账号创建时间统计，点击可查看新增门店列表\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 96,\n      \"module\": \"Web运营后台\",\n      \"sub_module\": \"控制台\",\n      \"function\": \"门店数量统计\",\n      \"sub_function\": \"活跃门店数\",\n      \"description\": \"显示最近30天内有至少一笔订单（含估价/成交/发货）的门店数量，支持点击跳转至门店管理并筛选活跃门店\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 97,\n      \"module\": \"Web运营后台\",\n      \"sub_module\": \"控制台\",\n      \"function\": \"收益概览\",\n      \"sub_function\": \"今日预估收益\",\n      \"description\": \"展示当日产生的平台收益（基于已质检通过订单的回收差价汇总），以金额数字带'¥'符号显示，下方展示较昨日变化百分比，统计口径为当日确认收货的订单\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 98,\n      \"module\": \"Web运营后台\",\n      \"sub_module\": \"控制台\",\n      \"function\": \"收益概览\",\n      \"sub_function\": \"本月累计收益\",\n      \"description\": \"展示本月1日至当日的平台总收益（全部质检通过订单的回收差价汇总），数字加粗显示，点击可查看月度收益趋势折线图（一期为静态）\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 99,\n      \"module\": \"Web运营后台\",\n      \"sub_module\": \"控制台\",\n      \"function\": \"收益概览\",\n      \"sub_function\": \"各品类收益占比\",\n      \"description\": \"以饼图或横向柱状图展示本月各品类（废旧手机、二手良品手机、废旧笔记本、废旧主机）的收益占比，各品类颜色固定（红色为废旧手机、绿色为二手手机、蓝色为笔记本、灰色为主机），悬停显示具体金额和百分比\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 100,\n      \"module\": \"Web运营后台\",\n      \"sub_module\": \"控制台\",\n      \"function\": \"实时刷新\",\n      \"sub_function\": \"自动刷新机制\",\n      \"description\": \"控制台页面所有数据卡片每5分钟自动向后端发起请求刷新数据，刷新时无全屏loading，仅对应卡片数字平滑过渡更新，更新前保留旧值，请求失败时保留上一周期数据并显示'数据更新失败'的小字提示，可手动点击刷新按钮立即拉取最新数据\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 101,\n      \"module\": \"Web运营后台\",\n      \"sub_module\": \"价格管理\",\n      \"function\": \"库存系统API对接与同步\",\n      \"sub_function\": \"定时同步任务\",\n      \"description\": \"对接库存系统API，按预设时间周期（如每日凌晨）自动拉取最新基准价格、机型图片等基础数据，确保价格与库存系统保持一致，同步过程支持手动触发补拉。\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 102,\n      \"module\": \"Web运营后台\",\n      \"sub_module\": \"价格管理\",\n      \"function\": \"库存系统API对接与同步\",\n      \"sub_function\": \"同步日志记录\",\n      \"description\": \"每次同步操作自动记录同步时间戳、拉取数据量（条数）、成功/失败状态及异常信息，日志列表支持按时间筛选和检索，用于运维监控和问题排查。\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 103,\n      \"module\": \"Web运营后台\",\n      \"sub_module\": \"价格管理\",\n      \"function\": \"多品类价格比例配置（百分比调价开关）\",\n      \"sub_function\": \"品类下调比例配置\",\n      \"description\": \"在Web后台价格管理页，分别展示废旧手机、二手良品手机、废旧笔记本、废旧主机四个品类的下调比例输入框，默认值分别为30%、15%、30%、30%，支持运营修改为0%-100%的整数，保存后立即生效。\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 104,\n      \"module\": \"Web运营后台\",\n      \"sub_module\": \"价格管理\",\n      \"function\": \"多品类价格比例配置（百分比调价开关）\",\n      \"sub_function\": \"即时同步前端\",\n      \"description\": \"配置保存后，系统立即重新计算各品类展示价并通过WebSocket或轮询机制推送到前端，无需等待定时同步，实现前端价格秒级更新。\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 105,\n      \"module\": \"Web运营后台\",\n      \"sub_module\": \"价格管理\",\n      \"function\": \"价格计算公式自动计算\",\n      \"sub_function\": \"自动计算展示价\",\n      \"description\": \"系统根据每个品类的库存基准价和已配置的下调比例，按公式「展示价 = 基准价 × (1 - 下调比例)」自动计算前端展示价格，计算结果实时写入价格缓存，用于C端小程序、AI智能体等各端展示。\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 106,\n      \"module\": \"Web运营后台\",\n      \"sub_module\": \"订单管理\",\n      \"function\": \"全量订单池与搜索筛选\",\n      \"sub_function\": \"订单列表与分页排序\",\n      \"description\": \"订单管理页面以表格展示所有估价、成交、发货记录，默认每页20条，支持切换每页50条/100条，按创建时间倒序排列，支持按时间、金额等字段升降序切换\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 107,\n      \"module\": \"Web运营后台\",\n      \"sub_module\": \"订单管理\",\n      \"function\": \"全量订单池与搜索筛选\",\n      \"sub_function\": \"多维度搜索与筛选\",\n      \"description\": \"支持按订单ID精确搜索；按创建时间、成交时间、发货时间筛选（今日/昨日/近7天/近30天/自定义时间段）；按订单状态筛选（待处理/已成交/已发货/待质检/已结算/已驳回），筛选结果实时刷新并显示当前筛选条件与结果总数\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 108,\n      \"module\": \"Web运营后台\",\n      \"sub_module\": \"订单管理\",\n      \"function\": \"全量订单池与搜索筛选\",\n      \"sub_function\": \"Excel批量导出\",\n      \"description\": \"在筛选结果基础上，点击导出按钮，将当前筛选条件下的订单明细以Excel格式导出，字段包含订单ID、用户信息、机型、估价、成交价、物流单号、物流公司、质检结果、结算状态等\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 109,\n      \"module\": \"Web运营后台\",\n      \"sub_module\": \"订单管理\",\n      \"function\": \"订单详情查看（含物流/质检/结算）\",\n      \"sub_function\": \"订单基本信息与物流追踪\",\n      \"description\": \"点击订单进入详情页，顶部展示订单ID、用户昵称/手机号、机型图片与名称、估价金额、成交金额及订单创建时间；物流区域显示物流单号、物流公司名称及当前物流状态（如运输中/已签收），物流状态由系统自动追踪更新，支持点击复制物流单号\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 110,\n      \"module\": \"Web运营后台\",\n      \"sub_module\": \"订单管理\",\n      \"function\": \"订单详情查看（含物流/质检/结算）\",\n      \"sub_function\": \"质检与结算状态展示\",\n      \"description\": \"详情页下方展示质检结果（通过/调整/驳回）、结算状态（待结算/已结算/已驳回），若质检调整则显示调整后的结算金额及原因，若驳回则显示驳回原因，同时展示冻结余额与解冻记录（针对发货订单）\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 111,\n      \"module\": \"Web运营后台\",\n      \"sub_module\": \"订单管理\",\n      \"function\": \"质检确认（解冻余额）\",\n      \"sub_function\": \"质检通过确认操作\",\n      \"description\": \"在订单详情页，质检部人员点击「确认收货质检通过」按钮，弹出二次确认弹窗，确认后系统自动将该订单对应的冻结余额解冻至可用余额，订单状态变更为「已结算」，并记录本次质检操作人及时刻\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 112,\n      \"module\": \"Web运营后台\",\n      \"sub_module\": \"订单管理\",\n      \"function\": \"质检确认（解冻余额）\",\n      \"sub_function\": \"解冻结果反馈\",\n      \"description\": \"确认解冻后，在订单详情和钱包流水同步显示解冻记录，可用余额立即增加，冻结余额相应减少；同时可触发短信/微信通知门店老板或推广人员余额已可用\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 113,\n      \"module\": \"Web运营后台\",\n      \"sub_module\": \"订单管理\",\n      \"function\": \"结算调整与驳回\",\n      \"sub_function\": \"结算金额调整\",\n      \"description\": \"质检部在订单详情页点击「调整结算金额」，弹出编辑框，修改结算金额（必须低于或等于原估价），并填写调整原因（必填）；提交后，系统将原冻结余额调整为新金额，剩余部分清零，订单状态变为「已结算（调整）」，并更新资金流水记录\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 114,\n      \"module\": \"Web运营后台\",\n      \"sub_module\": \"订单管理\",\n      \"function\": \"结算调整与驳回\",\n      \"sub_function\": \"订单驳回操作\",\n      \"description\": \"质检部在订单详情页点击「质检驳回」，弹出确认弹窗，填写驳回原因（必填）；确认后，该订单对应的冻结余额清零，订单状态变为「已驳回」，门店或推广人员的钱包中该笔冻结金额消失，订单可进入纠纷处理流程（一期手动）\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 115,\n      \"module\": \"Web运营后台\",\n      \"sub_module\": \"合作方管理\",\n      \"function\": \"门店管理（列表/资料审核/搜索/成交统计/钱包）\",\n      \"sub_function\": \"门店列表与搜索\",\n      \"description\": \"Web后台门店管理页面的核心列表，默认分页展示所有合作门店（每页20条，支持切换50/100条），列表字段包括门店名称、地址、联系人、合作协议签署状态、物流协议签署状态、门店审核状态、所属渠道商。顶部搜索框支持按门店名称、地址、联系人模糊搜索，同时支持按合作协议状态、审核状态筛选。每行提供「编辑」按钮修改门店基础资料。\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 116,\n      \"module\": \"Web运营后台\",\n      \"sub_module\": \"合作方管理\",\n      \"function\": \"门店管理（列表/资料审核/搜索/成交统计/钱包）\",\n      \"sub_function\": \"门店资料审核\",\n      \"description\": \"运营审核门店上传的门头照、店内环境照、营业执照。审核页面展示待审核图片列表，支持点击放大查看，运营可操作「通过」或「驳回」，驳回时需填写驳回原因。审核通过后门店图片在C端小程序附近门店页展示。运营也可手动替换门店展示图片。\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 117,\n      \"module\": \"Web运营后台\",\n      \"sub_module\": \"合作方管理\",\n      \"function\": \"门店管理（列表/资料审核/搜索/成交统计/钱包）\",\n      \"sub_function\": \"门店成交统计与钱包管理\",\n      \"description\": \"列表聚合展示每个门店的成交单数、成交金额、发货数量。点击门店可进入详情，查看冻结余额、可用余额、资金流水（冻结/解冻/提现记录），支持按时间范围筛选。一期不提供Excel导出。\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 118,\n      \"module\": \"Web运营后台\",\n      \"sub_module\": \"合作方管理\",\n      \"function\": \"推广人员管理（列表/资料审核/保证金/二维码/佣金结算/成交统计）\",\n      \"sub_function\": \"推广人员列表与资料审核\",\n      \"description\": \"Web后台推广人员管理页面，列表展示所有推广人员信息，包括姓名、手机号、审核状态、保证金缴纳状态（5000-10000元）、合作协议签署状态、物流协议签署状态、二维码状态、线下培训通过状态。顶部搜索框支持按姓名、手机号搜索。运营可在资料审核页面对推广人员上传的身份证照片、本人照片进行审核，通过后生效。\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 119,\n      \"module\": \"Web运营后台\",\n      \"sub_module\": \"合作方管理\",\n      \"function\": \"推广人员管理（列表/资料审核/保证金/二维码/佣金结算/成交统计）\",\n      \"sub_function\": \"保证金与二维码管理\",\n      \"description\": \"管理推广人员保证金账户，查看余额、扣罚记录、退还申请。运营可手动扣罚保证金（填写原因），审核退还申请并确认企业付款。二维码管理：可手动停用/启用推广人员专属二维码（离职时停用），停用后二维码即刻失效。\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 120,\n      \"module\": \"Web运营后台\",\n      \"sub_module\": \"合作方管理\",\n      \"function\": \"推广人员管理（列表/资料审核/保证金/二维码/佣金结算/成交统计）\",\n      \"sub_function\": \"佣金结算与成交统计\",\n      \"description\": \"查看质检确认后的佣金解冻记录，运营可手动确认解冻。统计每个推广人员的成交单数、总金额、质检通过率。资金流水可查看冻结余额、可用余额、提现记录，支持按时间筛选。\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 121,\n      \"module\": \"Web运营后台\",\n      \"sub_module\": \"合作方管理\",\n      \"function\": \"渠道合作方管理（账号开通/发展门店/交易流水/收益报表/业绩统计）\",\n      \"sub_function\": \"账号开通\",\n      \"description\": \"运营手动为渠道合作方创建子账号，填写手机号、初始密码并绑定渠道商角色。需确保合作协议已签署后方可开通。开通后渠道商使用独立账号+密码登录门店版小程序，系统自动识别角色并展示渠道商专属数据看板。\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 122,\n      \"module\": \"Web运营后台\",\n      \"sub_module\": \"合作方管理\",\n      \"function\": \"渠道合作方管理（账号开通/发展门店/交易流水/收益报表/业绩统计）\",\n      \"sub_function\": \"发展门店与交易流水\",\n      \"description\": \"页面展示渠道商发展的所有门店列表（名称、地址、入驻时间、累计成交单数、累计交易金额）。交易流水明细支持按时间筛选，显示名下所有门店的每一笔成交记录（订单ID、门店名称、机型、成交金额、交易时间），一期支持Excel导出。\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 123,\n      \"module\": \"Web运营后台\",\n      \"sub_module\": \"合作方管理\",\n      \"function\": \"渠道合作方管理（账号开通/发展门店/交易流水/收益报表/业绩统计）\",\n      \"sub_function\": \"收益报表与业绩统计\",\n      \"description\": \"展示渠道商本月收益概览（本月总交易额、预估返利金额、已结算返利金额）。收益报表按月汇总返利明细（一期手动Excel计算），历史结算记录显示每月返利状态（待结算/已打款）。平台运营端可查看所有渠道商的业绩统计总览：发展门店数、总交易流水、已结算佣金。\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 124,\n      \"module\": \"Web运营后台\",\n      \"sub_module\": \"物流管理\",\n      \"function\": \"京东API对接（运单查询/轨迹追踪）\",\n      \"sub_function\": \"京东物流下单接口集成\",\n      \"description\": \"基于京东物流开放平台API完成下单接口对接，对已签署物流协议的用户（门店老板/推广人员）提供一键发货时的运单生成服务，系统自动将公司预设收货地址填入发货单并调用京东物流下单接口，返回运单号。\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 125,\n      \"module\": \"Web运营后台\",\n      \"sub_module\": \"物流管理\",\n      \"function\": \"京东API对接（运单查询/轨迹追踪）\",\n      \"sub_function\": \"运单查询与轨迹追踪\",\n      \"description\": \"在Web后台物流管理页展示已发货订单的运单号和物流轨迹节点（揽收、运输、派送、签收），支持输入运单号精确查询，轨迹以时间线形式呈现，每节点附带时间戳和位置信息。\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 126,\n      \"module\": \"Web运营后台\",\n      \"sub_module\": \"物流管理\",\n      \"function\": \"京东API对接（运单查询/轨迹追踪）\",\n      \"sub_function\": \"物流状态定时同步\",\n      \"description\": \"通过定时任务（如每30分钟）轮询京东物流接口更新未完结订单的物流状态，将最新轨迹写入数据库，确保物流管理页展示的数据为实时或准实时状态，同时记录同步日志供排查。\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 127,\n      \"module\": \"Web运营后台\",\n      \"sub_module\": \"物流管理\",\n      \"function\": \"公司收货地址管理\",\n      \"sub_function\": \"默认收货地址配置\",\n      \"description\": \"在Web后台物流管理模块中预设唯一的公司收货地址（含联系人、联系电话、详细地址），该地址作为京东物流发货单的自动填入来源以及自行发货时的参考地址，首次设置后立即生效并应用于所有新增发货单。\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 128,\n      \"module\": \"Web运营后台\",\n      \"sub_module\": \"物流管理\",\n      \"function\": \"公司收货地址管理\",\n      \"sub_function\": \"地址修改与即时生效\",\n      \"description\": \"支持运营人员在后台修改收货地址的任意字段（联系人、电话、地址），修改后点击保存即时更新至系统配置，后续生成的发货单将自动使用新地址，同时记录修改历史供审计。\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 129,\n      \"module\": \"Web运营后台\",\n      \"sub_module\": \"物流管理\",\n      \"function\": \"自行发货物流记录追踪\",\n      \"sub_function\": \"物流单号手动录入\",\n      \"description\": \"针对未签署京东物流协议的用户（门店老板/推广人员），在发货时提供手动输入界面，用户选择物流公司（或输入名称）并填写物流单号，系统校验单号格式后存储并关联至对应订单，支持一次录入多单。\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 130,\n      \"module\": \"Web运营后台\",\n      \"sub_module\": \"物流管理\",\n      \"function\": \"自行发货物流记录追踪\",\n      \"sub_function\": \"第三方物流追踪集成\",\n      \"description\": \"对接快递100或类似第三方物流追踪API，根据用户输入的物流公司及单号自动抓取物流轨迹，数据更新频率为每2小时一次，失败时自动重试3次，轨迹信息包括物流状态（运输中、已签收、异常等）及具体经纬度或站点名称。\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 131,\n      \"module\": \"Web运营后台\",\n      \"sub_module\": \"物流管理\",\n      \"function\": \"自行发货物流记录追踪\",\n      \"sub_function\": \"发货记录查询与筛选\",\n      \"description\": \"在Web后台物流管理页展示所有自行发货的物流记录