rk\": \"\"\n    },\n    {\n      \"seq\": 25,\n      \"module\": \"门店老板版小程序\",\n      \"sub_module\": \"发货管理\",\n      \"function\": \"待发货列表\",\n      \"sub_function\": \"订单卡片展示\",\n      \"description\": \"列表页每行显示已确认卖给公司的订单信息，包括用户昵称、机型、AI估价金额、确认成交时间，卡片右侧提供「立即发走」和「自行发货」两个操作按钮，列表按成交时间倒序排列，支持下拉刷新。\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 26,\n      \"module\": \"门店老板版小程序\",\n      \"sub_module\": \"发货管理\",\n      \"function\": \"待发货列表\",\n      \"sub_function\": \"发货操作入口\",\n      \"description\": \"订单卡片上「立即发走」按钮仅对已签署物流协议的用户可见并可用，点击后跳转京东物流下单流程；「自行发货」按钮对所有用户可见，点击后跳转至物流单号录入页面。\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 27,\n      \"module\": \"门店老板版小程序\",\n      \"sub_module\": \"发货管理\",\n      \"function\": \"立即发走（京东物流）\",\n      \"sub_function\": \"一键生成运单\",\n      \"description\": \"点击后自动填入系统预设的唯一公司收货地址，调用京东物流API创建运单，生成物流单号，运费按京东物流优惠价计算并展示给用户确认，确认后弹出支付引导。\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 28,\n      \"module\": \"门店老板版小程序\",\n      \"sub_module\": \"发货管理\",\n      \"function\": \"立即发走（京东物流）\",\n      \"sub_function\": \"运费支付引导\",\n      \"description\": \"确认下单后弹出支付弹窗，展示运费金额、支付方式（微信支付），用户支付成功后运单生效，订单状态自动更新为「已发货」，AI估价金额进入冻结余额。\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 29,\n      \"module\": \"门店老板版小程序\",\n      \"sub_module\": \"发货管理\",\n      \"function\": \"自行发货（输入物流单号）\",\n      \"sub_function\": \"物流信息录入\",\n      \"description\": \"表单页面，用户自行选择物流公司（下拉列表包含主流物流公司如顺丰、中通、圆通等），输入物流单号，点击提交后系统通过第三方物流追踪API（如快递100）验证单号格式并自动抓取初始物流状态，提交成功后订单状态更新为「已发货」。\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 30,\n      \"module\": \"门店老板版小程序\",\n      \"sub_module\": \"发货管理\",\n      \"function\": \"自行发货（输入物流单号）\",\n      \"