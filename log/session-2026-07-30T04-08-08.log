emark\": \"\"\n    },\n    {\n      \"seq\": 36,\n      \"module\": \"门店老板版小程序\",\n      \"sub_module\": \"发货管理\",\n      \"function\": \"立即发走（京东物流）\",\n      \"sub_function\": \"一键生成运单\",\n      \"description\": \"点击后自动填入系统预设的唯一公司收货地址，调用京东物流API创建运单，生成物流单号，运费按京东物流优惠价计算并展示给用户确认，确认后弹出支付引导。\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 37,\n      \"module\": \"门店老板版小程序\",\n      \"sub_module\": \"发货管理\",\n      \"function\": \"立即发走（京东物流）\",\n      \"sub_function\": \"运费支付与状态更新\",\n      \"description\": \"确认下单后弹出支付弹窗，展示运费金额、支付方式（微信支付），用户支付成功后运单生效，订单状态自动更新为「已发货」，AI估价金额进入冻结余额。\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 38,\n      \"module\": \"门店老板版小程序\",\n      \"sub_module\": \"发货管理\",\n      \"function\": \"自行发货（输入物流单号）\",\n      \"sub_function\": \"物流信息录入\",\n      \"description\": \"表单页面，用户自行选择物流公司（下拉列表包含主流物流公司如顺丰、中通、圆通等），输入物流单号，点击提交后系统调用第三方物流追踪API（如快递100）校验单号格式并自动抓取初始物流状态，提交成功后订单状态更新为「已发货」。\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 39,\n      \"module\": \"门店老板版小程序\",\n      \"sub_module\": \"发货管理\",\n      \"function\": \"自行发货（输入物流单号）\",\n      \"sub_function\": \"单号校验与绑定\",\n      \"description\": \"系统对输入的单号进行格式校验（如长度、字符规则），校验通过后将物流单号绑定至当前订单，并回调第三方API获取初始轨迹，若无法识别则提示用户确认单号是否正确。\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 40,\n      \"module\": \"门店老板版小程序\",\n      \"sub_module\": \"发货管理\",\n      \"function\": \"发货记录追踪\",\n      \"sub_function\": \"物流状态卡片\",\n      \"description\": \"在订单详情页或独立发货记录列表中展示每条发货记录，显示物流公司名称、物流单号、最新物流状态（如已揽收、运输中、已签收）及更新时间，状态标签以颜色区分（绿色已签收、蓝色运输中、灰色待揽收）。\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 41,\n      \"module\": \"门店老板版小程序\",\n      \"sub_module\": \"发货管理\",\n      \"function\": \"发货记录追踪\",\n      \"sub_function\": \"物流轨迹详情\",\n      \"description\": \"点击物流状态卡片可进入物流轨迹详情页，基于第三方物流API获取的轨迹节点按时间倒序展示（如每一条物流站点记录），支持复制物流单号，对于京东物流的订单可直接跳转京东物流官网查询。\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 42,\n      \"module\": \"门店老板版小程序\",\n      \"sub_module\": \"数据看板\",\n      \"function\": \"用户增长数据（本月新增/累计）\",\n      \"sub_function\": \"客户数指标展示\",\n      \"description\": \"数据看板页面顶部区域，以文本卡片形式展示本月新增客户数和累计客户数两个统计指标，数值来源于平台引流到门店的客户数据，一期仅显示静态数字文本，不提供趋势图或导出功能。\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 43,\n      \"module\": \"门店老板版小程序\",\n      \"sub_module\": \"数据看板\",\n      \"function\": \"回收利润数据（单数/成本/营收/毛利/利润率）\",\n      \"sub_function\": \"利润指标面板\",\n      \"description\": \"数据看板中部区域，集中展示五个核心回收利润指标：本月回收单数、本月回收总成本、本月回收总营收、本月毛利、本月利润率（毛利率百分比），所有数值以醒目字体排列，数据来源为门店线下回收与线上发货结算的汇总，一期仅显示静态数字，不提供图表和导出。\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 44,\n      \"module\": \"门店老板版小程序\",\n      \"sub_module\": \"数据看板\",\n      \"function\": \"发货结算数据（单数/金额/待结算）\",\n      \"sub_function\": \"发货结算指标展示\",\n      \"description\": \"数据看板底部区域，展示三个与公司交易相关的指标：本月发货单数、本月发货结算金额（公司质检通过后的打款总额）、待结算金额（已发货但未质检的冻结余额汇总），数值实时同步订单质检状态，一期简化仅作文本展示，不提供趋势或筛选。\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 45,\n      \"module\": \"门店老板版小程序\",\n      \"sub_module\": \"我的\",\n      \"function\": \"店铺信息管理\",\n      \"sub_function\": \"店铺基本信息展示与编辑\",\n      \"description\": \"个人中心顶部区域，展示门店名称、详细地址、联系电话、微信号，支持点击编辑按钮跳转至编辑页面，修改地址、电话、微信后保存并刷新显示，编辑页面提供输入框和保存按钮\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 46,\n      \"module\": \"门店老板版小程序\",\n      \"sub_module\": \"我的\",\n      \"function\": \"店铺信息管理\",\n      \"sub_function\": \"门头照与店铺图片管理\",\n      \"description\": \"个人中心展示当前门头照片，支持点击上传/替换门头照和店铺环境图片（最多上传3张），上传后图片进入后台审核状态，审核通过前仍显示旧图，审核后自动更新\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 47,\n      \"module\": \"门店老板版小程序\",\n      \"sub_module\": \"我的\",\n      \"function\": \"我的钱包（冻结/可用余额+资金流水）\",\n      \"sub_function\": \"余额概览\",\n      \"description\": \"个人中心中部区域，分两行展示冻结余额和可用余额数值（带货币符号），冻结余额灰色、可用余额绿色，下方提示文案'可用余额可发起提现'，数值实时更新\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 48,\n      \"module\": \"门店老板版小程序\",\n      \"sub_module\": \"我的\",\n      \"function\": \"我的钱包（冻结/可用余额+资金流水）\",\n      \"sub_function\": \"资金流水列表\",\n      \"description\": \"点击'资金流水'进入列表页，按时间倒序展示每笔流水的类型（冻结/解冻/提现）、金额、时间、订单编号（关联订单时显示），支持下拉加载更多，空状态显示'暂无资金流水'，每页默认20条\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 49,\n      \"module\": \"门店老板版小程序\",\n      \"sub_module\": \"我的\",\n      \"function\": \"提现\",\n      \"sub_function\": \"发起提现\",\n      \"description\": \"个人中心底部'立即提现'按钮，仅当可用余额>0时可点击，点击后弹出提现弹窗，输入提现金额（需≤可用余额），确认后调用微信商家转账至零钱接口，提现成功后可用余额减少，资金流水增加一条提现记录，失败则提示原因\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 50,\n      \"module\": \"门店老板版小程序\",\n      \"sub_module\": \"AI智能体估价入口\",\n      \"function\": \"AI对话估价\",\n      \"sub_function\": \"估价引导对话\",\n      \"description\": \"在门店老板版小程序AI智能体入口点击进入的对话界面，基于微信客服接口+大语言模型实现，门店老板直接输入手机品牌型号或上传照片，AI自动识别并调用库存系统价格数据库获取基准价，根据后台配置的品类下调比例（如废旧手机30%、二手手机15%）计算展示价，无需区分废旧/二手分类，直接返回预估回收价\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 51,\n      \"module\": \"门店老板版小程序\",\n      \"sub_module\": \"AI智能体估价入口\",\n      \"function\": \"AI对话估价\",\n      \"sub_function\": \"估价结果与提醒\",\n      \"description\": \"对话界面返回报价信息，大字显示预估回收价（如¥XX），同时显示机型、内存等识别信息，底部附加统一提醒文字'此为AI预估价格，仅供参考，最终实际价格以公司质检确认为准'，并提供'一键生成发货单'按钮供门店老板直接进入发货流程\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 52,\n      \"module\": \"门店老板版小程序\",\n      \"sub_module\": \"AI智能体估价入口\",\n      \"function\": \"一键生成发货单\",\n      \"sub_function\": \"发货单生成\",\n      \"description\": \"点击'一键生成发货单'后，系统自动基于当前AI估价结果创建发货订单，生成唯一订单ID（格式GS20260726XXXXX），订单状态置为'待发货'，估价金额自动进入门店老板的冻结余额，同时将用户信息、机型、估价金额等数据写入订单记录\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 53,\n      \"module\": \"门店老板版小程序\",\n      \"sub_module\": \"AI智能体估价入口\",\n      \"function\": \"一键生成发货单\",\n      \"sub_function\": \"物流下单跳转\",\n      \"description\": \"生成发货单后自动跳转至发货管理页面的待发货列表，聚焦该订单，展示'立即发走'（京东物流，需签署物流协议）和'自行发货'两个操作选项，门店老板选择后进入对应物流下单流程（京东物流自动填公司地址并调用API下单，自行发货需手动输入物流单号）\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 54,\n      \"module\": \"推广人员版小程序\",\n      \"sub_module\": \"登录页面\",\n      \"function\": \"账号密码登录验证\",\n      \"sub_function\": \"登录验证流程\",\n      \"description\": \"登录页面输入账号（手机号）和密码，点击「登录」按钮调用后台接口验证，验证通过进入推广人员版首页，验证失败提示'账号或密码错误，请重试'；未登录状态下无法查看任何页面，系统根据角色隔离展示不同界面（门店版/推广版/渠道商版）\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 55,\n      \"module\": \"推广人员版小程序\",\n      \"sub_module\": \"登录页面\",\n      \"function\": \"忘记密码重置\",\n      \"sub_function\": \"找回密码流程\",\n      \"description\": \"点击「忘记密码」按钮后跳转至找回密码页面，输入已绑定手机号获取验证码，验证通过后设置新密码，完成密码重置\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 56,\n      \"module\": \"推广人员版小程序\",\n      \"sub_module\": \"登录页面\",\n      \"function\": \"首次登录强制修改密码\",\n      \"sub_function\": \"强制修改密码流程\",\n      \"description\": \"首次使用初始密码登录成功后强制跳转至修改密码页面，要求输入旧密码和新密码，新密码需符合复杂度规则，修改成功后自动退出并提示使用新密码重新登录\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": 