nager\": 0.4,\n        \"testing\": 0.4,\n        \"design\": 0.8\n      },\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 136,\n      \"module\": \"AI智能体\",\n      \"sub_module\": \"估价引擎\",\n      \"function\": \"机型识别与基准价匹配\",\n      \"sub_function\": \"废旧/二手分类判断\",\n      \"description\": \"根据用户输入的机况描述（如不开机、屏幕坏、正常使用、外观划痕等），结合对话上下文智能判断手机属于废旧还是二手类别，以确定后续的价格计算模型和引导流程\",\n      \"category\": \"feature\",\n      \"trades\": {\n        \"frontend\": 0.6,\n        \"backend\": 1.2,\n        \"product-manager\": 0.4,\n        \"testing\": 0.4,\n        \"design\": 0.4\n      },\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 137,\n      \"module\": \"AI智能体\",\n      \"sub_module\": \"估价引擎\",\n      \"function\": \"机型识别与基准价匹配\",\n      \"sub_function\": \"基准价查询匹配\",\n      \"description\": \"根据识别出的品牌型号和分类（废旧/二手），调用库存系统API实时查询对应的基准回收价格，若API无匹配则返回估算价格区间并提示以门店验机为准\",\n      \"category\": \"feature\",\n      \"trades\": {\n        \"frontend\": 0.4,\n        \"backend\": 1.2,\n        \"product-manager\": 0.2,\n        \"testing\": 0.4,\n        \"design\": 0.4\n      },\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 138,\n      \"module\": \"AI智能体\",\n      \"sub_module\": \"估价引擎\",\n      \"function\": \"价格计算与应用下调比例\",\n      \"sub_function\": \"多品类下调比例获取\",\n      \"description\": \"从后台价格管理配置中读取对应品类的百分比下调比例，支持废旧手机（默认30%）、二手手机（默认15%）、废旧笔记本（默认30%）、废旧主机（默认30%），运营可在后台动态调整，调整后前端实时生效\",\n      \"category\": \"feature\",\n      \"trades\": {\n        \"frontend\": 1.2,\n        \"backend\": 1.6,\n        \"product-manager\": 0.4,\n        \"testing\": 0.4,\n        \"design\": 1\n      },\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 139,\n      \"module\": \"AI智能体\",\n      \"sub_module\": \"估价引擎\",\n      \"function\": \"价格计算与应用下调比例\",\n      \"sub_function\": \"展示价计算\",\n      \"description\": \"按照公式「展示价 = 库存基准价 × (1 - 下调比例)」计算前端展示价格，结果四舍五入取整。根据机型所属品类自动选用对应的下调比例，确保不同品类价格独立计算\",\n      \"category\": \"feature\",\n      \"trades\": {\n        \"frontend\": null,\n        \"backend\": 0.4,\n        \"product-manager\": 0.2,\n        \"testing\": 0.2,\n        \"design\": null\n      },\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 140,\n      \"module\": \"AI智能体\",\n      \"sub_module\": \"估价引擎\",\n      \"function\": \"价格计算与应用下调比例\",\n      \"sub_function\": \"价格缓存与实时同步\",\n      \"description\": \"估价引擎在计算时优先使用内存中的最新比例配置和近期同步的基准价，后台调整比例或库存系统更新基准价后，前端页面和AI报价在数秒内反映最新价格，避免用户看到过期报价\",\n      \"category\": \"feature\",\n      \"trades\": {\n        \"frontend\": 0.6,\n        \"backend\": 1.6,\n        \"product-manager\": 0.2,\n        \"testing\": 0.4,\n        \"design\": null\n      },\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 141,\n      \"module\": \"AI智能体\",\n      \"sub_module\": \"估价引擎\",\n      \"function\": \"估价结果展示与提醒\",\n      \"sub_function\": \"AI对话估价结果播报\",\n      \"description\": \"在AI智能体对话窗口中，根据估价结果生成自然语言回复，包含品牌型号、机况/成色描述和预估价格，并以『此为AI预估价格，仅供参考，最终实际价格需当面验机确认』作为统一结尾，支持废旧和二手两种不同话术模板\",\n      \"category\": \"feature\",\n      \"trades\": {\n        \"frontend\": 0.4,\n        \"backend\": 0.6,\n        \"product-manager\": 0.2,\n        \"testing\": 0.2,\n        \"design\": 0.4\n      },\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 142,\n      \"module\": \"AI智能体\",\n      \"sub_module\": \"估价引擎\",\n      \"function\": \"估价结果展示与提醒\",\n      \"sub_function\": \"价格详情页展示\",\n      \"description\": \"在小程序估价结果页或自主查价机型详情页中，醒目展示报废回收价（红色）和二手回收价（绿色），同时显示机型图片、型号名称，并在价格下方显著标注『以上价格为AI预估，仅供参考，最终价格以门店现场当面验机确认为准』\",\n      \"category\": \"feature\",\n      \"trades\": {\n        \"frontend\": 1.2,\n        \"backend\": 0.4,\n        \"product-manager\": 0.2,\n        \"testing\": 0.4,\n        \"design\": 1.2\n      },\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 143,\n      \"module\": \"AI智能体\",\n      \"sub_module\": \"估价引擎\",\n      \"function\": \"估价结果展示与提醒\",\n      \"sub_function\": \"估价后门店引导\",\n      \"description\": \"估价结果页面底部自动展示距离用户最近的1-2家合作门店信息（门头照、店名、地址、距离），提供一键拨号、一键导航和添加微信按钮，引导用户到店完成实际交易\",\n      \"category\": \"feature\",\n      \"trades\": {\n        \"frontend\": 1.4,\n        \"backend\": 1.2,\n        \"product-manager\": 0.4,\n        \"testing\": 0.4,\n        \"design\": 1\n      },\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 144,\n      \"module\": \"AI智能体\",\n      \"sub_module\": \"容错兜底\",\n      \"function\": \"型号识别失败兜底\",\n      \"sub_function\": \"连续识别失败触发\",\n      \"description\": \"AI智能体在对话流程中持续跟踪型号识别失败的次数，当同一会话内连续两次未能识别用户描述的型号时，自动触发兜底机制，避免无限追问\",\n      \"category\": \"feature\",\n      \"trades\": {\n        \"frontend\": null,\n        \"backend\": 1,\n        \"product-manager\": 0.2,\n        \"testing\": 0.4,\n        \"design\": null\n      },\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 145,\n      \"module\": \"AI智能体\",\n      \"sub_module\": \"容错兜底\",\n      \"function\": \"型号识别失败兜底\",\n      \"sub_function\": \"兜底引导话术回复\",\n      \"description\": \"触发兜底后，AI自动回复预设话术：“您描述的机型我需要进一步确认，正在为您查找最近的门店……”，向用户说明当前状况并明确下一步动作\",\n      \"category\": \"feature\",\n      \"trades\": {\n        \"frontend\": null,\n        \"backend\": 0.2,\n        \"product-manager\": 0.2,\n        \"testing\": 0.2,\n        \"design\": null\n      },\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 146,\n      \"module\": \"AI智能体\",\n      \"sub_module\": \"容错兜底\",\n      \"function\": \"型号识别失败兜底\",\n      \"sub_function\": \"推送小程序卡片与门店引导\",\n      \"description\": \"系统在话术回复后自动推送C端小程序的附近门店卡片，用户点击可直接查看就近门店信息（门头照、地址、距离、电话），引导用户自行联系门店完成线下估价和交易\",\n      \"category\": \"feature\",\n      \"trades\": {\n        \"frontend\": 0.8,\n        \"backend\": 1.2,\n        \"product-manager\": 0.2,\n        \"testing\": 0.6,\n        \"design\": 0.8\n      },\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 147,\n      \"module\": \"AI智能体\",\n      \"sub_module\": \"容错兜底\",\n      \"function\": \"价格缺失兜底\",\n      \"sub_function\": \"价格区间预估与话术回复\",\n      \"description\": \"当库存系统中完全无匹配机型的基准价时，AI回复一个基