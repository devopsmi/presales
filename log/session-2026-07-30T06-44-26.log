le\": \"门店老板版小程序\",\n      \"sub_module\": \"发货管理\",\n      \"function\": \"京东物流一键发货\",\n      \"sub_function\": \"京东运单创建与支付\",\n      \"description\": \"用户确认发货后，调用京东物流API创建运单，返回物流单号；系统从用户可用余额扣除运费（不足时引导微信补充支付），生成后订单状态变更为『已发货』，估价金额自动转入冻结余额。\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 33,\n      \"module\": \"门店老板版小程序\",\n      \"sub_module\": \"发货管理\",\n      \"function\": \"自行发货（物流单号输入与追踪）\",\n      \"sub_function\": \"物流公司与单号录入\",\n      \"description\": \"提供常用物流公司下拉选择（顺丰、中通、圆通、韵达等），用户输入快递单号（支持手动输入或调起摄像头扫码识别），系统校验单号格式后保存，关联当前订单。\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 34,\n      \"module\": \"门店老板版小程序\",\n      \"sub_module\": \"发货管理\",\n      \"function\": \"自行发货（物流单号输入与追踪）\",\n      \"sub_function\": \"物流轨迹自动追踪\",\n      \"description\": \"对接第三方物流追踪API（快递100），保存单号后自动查询并展示最新物流状态（如『运输中』『已签收』），每2小时更新一次，用户可点击查看完整物流节点时间线。\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 35,\n      \"module\": \"门店老板版小程序\",\n      \"sub_module\": \"发货管理\",\n      \"function\": \"发货记录查看\",\n      \"sub_function\": \"已发货历史列表\",\n      \"description\": \"按时间倒序展示所有已发货订单，每条记录包含订单号、机型、物流公司、物流单号、当前物流状态图标（运输中/已签收/异常）及发货时间，默认每页20条，支持上拉加载更多。\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 36,\n      \"module\": \"门店老板版小程序\",\n      \"sub_module\": \"发货管理\",\n      \"function\": \"发货记录查看\",\n      \"sub_function\": \"物流详情弹层\",\n      \"description\": \"点击任意记录弹出半屏物流详情，展示从揽件到签收的完整轨迹节点（时间、地点、状态描述），异常状态（如退回、滞留）用红色高亮，并显示客服联系方式。\",\n      \"category\": \"feature\",\n      \"trades\": {},\n      \"remark\": \"\"\n    },\n    {\n      \"seq\": 37,\n      \"module\": \"门店老板版小程序\",\n      \"sub_module\": \"数据看板\",\n      \"function\": \"用户增长数据指标\",\n      \"sub_function\": \"本月新增客户数\",\n      \"description\": \"数据看板『用户增长』区块中的第一个指标，以